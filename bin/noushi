#!/bin/sh
set -eu
script_path=$0
case $script_path in
	/*) ;;
	*) script_path=$PWD/$script_path ;;
esac
while [ -L "$script_path" ]; do
	script_dir=$(CDPATH= cd -P "$(dirname "$script_path")" && pwd)
	link=$(readlink "$script_path")
	case $link in
		/*) script_path=$link ;;
		*) script_path=$script_dir/$link ;;
	esac
done
repo_root=$(CDPATH= cd -P "$(dirname "$script_path")/.." && pwd)
engine="$repo_root/packages/coding-agent/dist/cli.js"
if [ ! -f "$engine" ]; then
	printf '%s\n' "Noushi is not built. From the repository root, run: npm ci && npm run build:noushi" >&2
	exit 1
fi
exec node "$engine" "$@"
